{
  "Server": {
    "Port": 9999,
    "MaxPayloadSizeBytes": 10000000,
    "DatabasePath": "data/messenger.db"
  },
  "Logging": {
    "DirectoryPath": "logs/",
    "FileNameTemplate": "server_log_.txt",
    "ConsoleOutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}{Exception}",
    "FileOutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
  },
  "BusinessRules": {
    "DefaultGuestName": "Guest",
    "AdminLoginIdentifier": "admin",
    "MinLoginLength": 3
  }
}