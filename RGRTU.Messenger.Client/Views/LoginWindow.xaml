<Window x:Class="RGRTU.Messenger.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мессенджер РГРТУ - Вход" Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <!-- Исправленная часть: тень задается через Border.Effect -->
    <Border Background="White" CornerRadius="10" Padding="30" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="5" Opacity="0.2" BlurRadius="10"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Мессенджер РГРТУ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#1F2937"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="#4B5563"/>
            <TextBox x:Name="LoginTextBox" Height="35" Padding="10,0" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="#4B5563"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="10,0" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,20"/>

            <Button x:Name="LoginButton" Content="Войти" Height="40" FontSize="16" FontWeight="SemiBold" 
                    Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="LoginButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock x:Name="ErrorTextBlock" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>