<Window x:Class="RGRTU.Messenger.Client.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="460" Width="480"
        MinHeight="420" MinWidth="440"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Border Margin="14" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.12" BlurRadius="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="Добавить пользователя"
                       FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrushBlue}"
                       Margin="0,0,0,18"/>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Логин" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrushBlue}"/>
                <TextBox x:Name="LoginTextBox" Grid.Column="1" Style="{StaticResource AdminTextBoxStyle}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Имя в чате" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrushBlue}"/>
                <TextBox x:Name="DisplayNameTextBox" Grid.Column="1" Style="{StaticResource AdminTextBoxStyle}"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Роль" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrushBlue}"/>
                <ComboBox x:Name="RoleComboBox" Grid.Column="1" Style="{StaticResource AdminComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="Пользователь"/>
                    <ComboBoxItem Content="Администратор"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PasswordLabelTextBlock" Text="Пароль" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextBrushBlue}"/>
                <PasswordBox x:Name="PasswordBox" Grid.Column="1" Style="{StaticResource AdminPasswordBoxStyle}"/>
            </Grid>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ConfirmPasswordLabelTextBlock" Text="Подтверждение" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource TextBrushBlue}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Style="{StaticResource AdminPasswordBoxStyle}"/>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ErrorTextBlock" Grid.Column="0" Text="" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Отмена" Width="95" Margin="0,0,10,0"
                            Style="{StaticResource LightButtonStyle}" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Width="115"
                            Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource AccentBrush}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
