<Window x:Class="RGRTU.Messenger.Client.Views.ChatInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о чате" Height="600" Width="740"
        MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="ChatInfoWindow_Loaded">
    <Grid Margin="12">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"
                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Участники чата" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrushBlue}" Margin="0,0,0,10"/>

                <DataGrid x:Name="MembersDataGrid" Grid.Row="1" Style="{StaticResource AdminDataGridStyle}"
                          CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          GridLinesVisibility="None" RowHeight="54" Margin="0,0,0,14">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Пользователь" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrushBlue}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding OnlineStatusText}" FontSize="11" FontStyle="Italic"
                                                   Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="MemberActionColumn" Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}"
                                            Padding="10,5" Margin="6,0" VerticalAlignment="Center"
                                            Visibility="{Binding ActionVisibility}"
                                            Tag="{Binding Id}" Click="ChatMemberActionButton_Click"
                                            Style="{StaticResource LightButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="Вложения чата" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrushBlue}" Margin="0,0,0,10"/>

                <Border Grid.Row="3" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1" Padding="8">
                    <ListBox x:Name="AttachmentGroupsListBox" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Click="AttachmentGroup_Click" Tag="{Binding}" Margin="0,2"
                                        Style="{StaticResource LightButtonStyle}" HorizontalContentAlignment="Stretch" Padding="12,10">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrushBlue}">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="#64748B"/>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>