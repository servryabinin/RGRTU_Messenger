<Window x:Class="RGRTU.Messenger.Client.Views.ChatInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о чате" Height="560" Width="720"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"
                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Участники чата" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrushBlue}" Margin="0,0,0,10"/>

                <DataGrid x:Name="MembersDataGrid" Grid.Row="1" Style="{StaticResource AdminDataGridStyle}"
                          CanUserDeleteRows="False" CanUserResizeRows="False" Margin="0,0,0,14">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AdminDataGridColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding DisplayName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Статус" Binding="{Binding OnlineStatusText}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Text="Вложения чата" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrushBlue}" Margin="0,0,0,10"/>

                <Border Grid.Row="3" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1" Padding="8">
                    <ListBox x:Name="AttachmentGroupsListBox" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Click="AttachmentGroup_Click" Tag="{Binding}" Margin="0,2"
                                        Style="{StaticResource LightButtonStyle}" HorizontalContentAlignment="Stretch" Padding="12,10">
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrushBlue}">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="#64748B"/>
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>