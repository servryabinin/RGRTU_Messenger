<Window x:Class="RGRTU.Messenger.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RGRTU.Messenger.Client.Controls"
        Title="Мессенджер РГРТУ" Height="720" Width="1200"
        MinWidth="1000" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: текущий пользователь и выход -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1"
                Padding="12,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Мессенджер РГРТУ" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrushBlue}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                    <TextBlock x:Name="CurrentUserLoginTextBlock" Text="" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextBrushBlue}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CurrentUserRoleTextBlock" Text="" FontSize="11"
                               Foreground="#64748B" HorizontalAlignment="Right"/>
                </StackPanel>

                <Button x:Name="LogoutButton" Grid.Column="2" Content="Выйти" Height="32" Padding="16,0"
                        Style="{StaticResource LightButtonStyle}" Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.1" BlurRadius="10"/>
            </Border.Effect>

            <!-- Верхняя граница отделяет заголовки вкладок от их содержимого -->
            <TabControl x:Name="MainTabControl" Background="Transparent"
                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">

                <!-- ВКЛАДКА ЧАТА -->
                <TabItem x:Name="ChatTabItem" Header="Чат">
                    <Grid Margin="8">
                        <Border Background="White" CornerRadius="10" Padding="12"
                                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Верхняя панель чата -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ChatInfoButton" HorizontalAlignment="Left" Padding="8,4"
                                            Style="{StaticResource LightButtonStyle}" Click="ChatInfoButton_Click">
                                        <TextBlock Text="Чат" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrushBlue}"/>
                                    </Button>

                                    <Button x:Name="ChatMenuButton" Grid.Column="1" Content="⋮" Width="40" Height="36"
                                            FontSize="20" FontWeight="Bold" Padding="0"
                                            Style="{StaticResource LightButtonStyle}" Click="ChatMenuButton_Click"/>
                                    <Popup x:Name="ChatMenuPopup" PlacementTarget="{Binding ElementName=ChatMenuButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrushBlue}"
                                                BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,6,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="8"/>
                                            </Border.Effect>
                                            <Button x:Name="LeaveChatButton" Content="Покинуть чат" Padding="12,8"
                                                    Style="{StaticResource LightButtonStyle}" Click="LeaveChatButton_Click"/>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <ListBox x:Name="MessagesListBox" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="2"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Soft highlight when jumping to replied message -->
                                                    <Border Grid.ColumnSpan="2" CornerRadius="12" IsHitTestVisible="False"
                                                            Opacity="{Binding HighlightOpacity}" Margin="-4">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#003B82F6" Offset="0"/>
                                                                <GradientStop Color="#553B82F6" Offset="0.5"/>
                                                                <GradientStop Color="#003B82F6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Selection circle for own messages -->
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                                            VerticalAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                                            Background="White" Visibility="{Binding SelectionVisibility}"
                                                            MouseLeftButtonUp="SelectionCircle_Click" Tag="{Binding}">
                                                        <TextBlock Text="{Binding SelectionMark}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <Border Grid.Column="1" MaxWidth="520" Padding="10,8" CornerRadius="12"
                                                            Background="{Binding BubbleBrush}"
                                                            BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                                            HorizontalAlignment="{Binding Alignment}"
                                                            Tag="{Binding}" MouseRightButtonUp="MessageBorder_MouseRightButtonUp">
                                                        <Border.ContextMenu>
                                                            <ContextMenu Opened="MessageContextMenu_Opened" Placement="MousePoint"
                                                                         HasDropShadow="False" Background="Transparent" BorderThickness="0">
                                                                <ContextMenu.Template>
                                                                    <ControlTemplate TargetType="ContextMenu">
                                                                        <Border Background="White" BorderBrush="{StaticResource BorderBrushBlue}"
                                                                                BorderThickness="1" CornerRadius="8" Padding="6" Margin="8">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="8"/>
                                                                            </Border.Effect>
                                                                            <StackPanel IsItemsHost="True"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ContextMenu.Template>
                                                                <ContextMenu.Resources>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrushBlue}"/>
                                                                        <Setter Property="FontSize" Value="13"/>
                                                                        <Setter Property="Padding" Value="10,8"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="MenuItem">
                                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter ContentSource="Header"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </ContextMenu.Resources>
                                                                <MenuItem Header="Ответить" Click="ReplyMenuItem_Click"/>
                                                                <MenuItem Header="Изменить" Click="EditMenuItem_Click"/>
                                                                <MenuItem Header="Копировать текст" Click="CopyMenuItem_Click"/>
                                                                <MenuItem Header="Удалить" Click="DeleteMenuItem_Click"/>
                                                                <MenuItem Header="Выделить" Click="SelectMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding SenderBrush}" Margin="0,0,0,2"
                                                                       Visibility="{Binding SenderVisibility}"/>

                                                            <!-- Reply preview -->
                                                            <Border Visibility="{Binding ReplyVisibility}" Background="#FFFFFFAA"
                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0"
                                                                    Padding="6,2" Margin="0,0,0,4" CornerRadius="2"
                                                                    Cursor="Hand" MouseLeftButtonUp="ReplyPreview_Click" Tag="{Binding}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ReplyToSenderName}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentBrush}"/>
                                                                    <TextBlock Text="{Binding ReplyPreview}" FontSize="11"
                                                                               Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Передача файла: видна только отправителю, пока файл не загружен -->
                                                            <Border Visibility="{Binding UploadingVisibility}" Background="#F1F5F9"
                                                                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                                                    Padding="10,8" Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="36" Height="36" Margin="0,0,10,0">
                                                                        <TextBlock Text="📄" FontSize="18" Foreground="#94A3B8"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="⟳" FontSize="18" FontWeight="Bold"
                                                                                   Foreground="#64748B"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   RenderTransformOrigin="0.5,0.5">
                                                                            <TextBlock.RenderTransform>
                                                                                <RotateTransform/>
                                                                            </TextBlock.RenderTransform>
                                                                            <TextBlock.Triggers>
                                                                                <EventTrigger RoutedEvent="Loaded">
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation
                                                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                From="0" To="360" Duration="0:0:1"
                                                                                                RepeatBehavior="Forever"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </EventTrigger>
                                                                            </TextBlock.Triggers>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding AttachmentDisplay}" FontSize="13"
                                                                                   FontWeight="SemiBold" Foreground="#475569"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding UploadProgressText}" FontSize="11"
                                                                                   Foreground="#64748B" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Изображение: показываем прямо в чате, по клику открываем во внешнем просмотрщике -->
                                                            <Border Visibility="{Binding ImageVisibility}" CornerRadius="10"
                                                                    Margin="0,0,0,4" Cursor="Hand" ClipToBounds="True"
                                                                    Tag="{Binding}" MouseLeftButtonUp="MediaAttachment_Click">
                                                                <Image Source="{Binding ImageSource}" MaxWidth="320" MaxHeight="240"
                                                                       Stretch="Uniform" StretchDirection="DownOnly"/>
                                                            </Border>

                                                            <!-- Видео: автовоспроизведение без звука + переключатель звука -->
                                                            <Border Visibility="{Binding VideoVisibility}" CornerRadius="10"
                                                                    Margin="0,0,0,4" Cursor="Hand" Background="Black"
                                                                    ClipToBounds="True" Tag="{Binding}"
                                                                    MouseLeftButtonUp="MediaAttachment_Click">
                                                                <Grid>
                                                                    <MediaElement Source="{Binding VideoSourcePath}"
                                                                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                                                  Stretch="Uniform" StretchDirection="DownOnly"
                                                                                  MaxWidth="320" MaxHeight="240"
                                                                                  IsHitTestVisible="False"
                                                                                  IsMuted="True" Volume="0"
                                                                                  Loaded="VideoMediaElement_Loaded"
                                                                                  MediaOpened="VideoMediaElement_MediaOpened"
                                                                                  Unloaded="VideoMediaElement_Unloaded"/>
                                                                    <Button Content="{Binding MuteIcon}" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top" Width="30" Height="30" Margin="6"
                                                                            FontSize="14" Padding="0" Background="#AA000000"
                                                                            Foreground="White" Tag="{Binding}" Cursor="Hand"
                                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                                            Click="VideoMuteButton_Click"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Обычный файл: сохранить через проводник -->
                                                            <Border Visibility="{Binding FileVisibility}" Background="#FFFFFFCC"
                                                                    BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1"
                                                                    CornerRadius="8" Padding="8,6" Margin="0,0,0,4" Cursor="Hand"
                                                                    MouseLeftButtonUp="AttachmentBlock_Click" Tag="{Binding}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding AttachmentDisplay}" FontSize="13"
                                                                               Foreground="{StaticResource TextBrushBlue}" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding AttachmentSizeText}" FontSize="11"
                                                                               Foreground="#64748B" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="Нажмите, чтобы сохранить" FontSize="10"
                                                                               Foreground="#64748B"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                                       Foreground="#1E293B" Visibility="{Binding TextVisibility}"/>
                                                            <TextBlock Text="Изменено" FontSize="10" FontStyle="Italic"
                                                                       Foreground="#64748B" Visibility="{Binding EditedVisibility}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="0,4,0,0"
                                                                       HorizontalAlignment="Right" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock x:Name="NotInChatTextBlock" Text="Вы не добавлены в чат"
                                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                                </Grid>

                                <Grid x:Name="ChatInputGrid" Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Превью ответа / редактирования / вложения -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                        <Border x:Name="ReplyPreviewBorder" Visibility="Collapsed"
                                                Background="#F8FBFF" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="ReplyPreviewSenderTextBlock" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                    <TextBlock x:Name="ReplyPreviewTextBlock" FontSize="12"
                                                               Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" Width="26" Height="26" Margin="8,0,0,0"
                                                        Style="{StaticResource LightButtonStyle}" Padding="0"
                                                        Click="CancelReplyButton_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="EditPreviewBorder" Visibility="Collapsed"
                                                Background="#FFF7ED" BorderBrush="#F59E0B"
                                                BorderThickness="2,0,0,0" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="EditPreviewTextBlock" FontSize="12"
                                                           Foreground="#92400E" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="✕" Width="26" Height="26" Margin="8,0,0,0"
                                                        Style="{StaticResource LightButtonStyle}" Padding="0"
                                                        Click="CancelEditButton_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="AttachmentPreviewBorder" Visibility="Collapsed"
                                                Background="#F8FBFF" BorderBrush="{StaticResource BorderBrushBlue}"
                                                BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AttachmentPreviewTextBlock" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextBrushBlue}" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="✕" Width="26" Height="26" Margin="8,0,0,0"
                                                        Style="{StaticResource LightButtonStyle}" Padding="0"
                                                        Click="RemoveAttachmentButton_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Кнопка вложения -->
                                        <Button x:Name="AttachButton" Grid.Column="0" Content="+" Width="42" Height="42" Margin="0,0,8,0"
                                                FontSize="22" FontWeight="Bold" Padding="0"
                                                Style="{StaticResource LightButtonStyle}" Click="AttachButton_Click"/>
                                        <Popup x:Name="AttachPopup" PlacementTarget="{Binding ElementName=AttachButton}"
                                               Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrushBlue}"
                                                    BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,6">
                                                <Button Content="Прикрепить файл" Padding="12,8"
                                                        Style="{StaticResource LightButtonStyle}" Click="PickFileButton_Click"/>
                                            </Border>
                                        </Popup>

                                        <TextBox x:Name="MessageInputTextBox" Grid.Column="1" Height="42" Padding="12,0" FontSize="14"
                                                 BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="MessageInputTextBox_KeyDown" TextWrapping="Wrap" AcceptsReturn="True"/>

                                        <!-- Смайлики -->
                                        <Button x:Name="EmojiButton" Grid.Column="2" Content="😊" Width="42" Height="42" Margin="8,0,0,0"
                                                FontSize="20" Padding="0" Style="{StaticResource LightButtonStyle}"
                                                Click="EmojiButton_Click" MouseEnter="EmojiButton_MouseEnter"/>
                                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}"
                                               Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrushBlue}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                                <WrapPanel Width="260">
                                                    <WrapPanel.Resources>
                                                        <Style TargetType="Button" BasedOn="{StaticResource LightButtonStyle}">
                                                            <Setter Property="Width" Value="36"/>
                                                            <Setter Property="Height" Value="36"/>
                                                            <Setter Property="Margin" Value="2"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="FontSize" Value="20"/>
                                                        </Style>
                                                    </WrapPanel.Resources>
                                                    <Button Content="😀" Click="EmojiPickButton_Click"/><Button Content="😁" Click="EmojiPickButton_Click"/>
                                                    <Button Content="😂" Click="EmojiPickButton_Click"/><Button Content="😊" Click="EmojiPickButton_Click"/>
                                                    <Button Content="😍" Click="EmojiPickButton_Click"/><Button Content="😎" Click="EmojiPickButton_Click"/>
                                                    <Button Content="👍" Click="EmojiPickButton_Click"/><Button Content="🙏" Click="EmojiPickButton_Click"/>
                                                    <Button Content="🔥" Click="EmojiPickButton_Click"/><Button Content="🎉" Click="EmojiPickButton_Click"/>
                                                    <Button Content="❤️" Click="EmojiPickButton_Click"/><Button Content="✅" Click="EmojiPickButton_Click"/>
                                                    <Button Content="🤔" Click="EmojiPickButton_Click"/><Button Content="😢" Click="EmojiPickButton_Click"/>
                                                    <Button Content="😡" Click="EmojiPickButton_Click"/><Button Content="👏" Click="EmojiPickButton_Click"/>
                                                    <Button Content="💡" Click="EmojiPickButton_Click"/><Button Content="📎" Click="EmojiPickButton_Click"/>
                                                    <Button Content="🚀" Click="EmojiPickButton_Click"/><Button Content="⭐" Click="EmojiPickButton_Click"/>
                                                </WrapPanel>
                                            </Border>
                                        </Popup>

                                        <Grid Grid.Column="3" Margin="8,0,0,0">
                                            <Button x:Name="SendButton" Content="➤" Width="52" Height="42"
                                                    Background="{StaticResource AccentBrush}" Foreground="White" FontSize="18"
                                                    Style="{StaticResource PrimaryButtonStyle}" Click="SendButton_Click"/>
                                            <StackPanel x:Name="EditActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Content="Редактировать" Height="42" Padding="10,0" Margin="0,0,6,0"
                                                        Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource AccentBrush}"
                                                        Click="ConfirmEditButton_Click"/>
                                                <Button Content="Отмена" Height="42" Padding="10,0"
                                                        Style="{StaticResource LightButtonStyle}" Click="CancelEditButton_Click"/>
                                            </StackPanel>
                                            <StackPanel x:Name="SelectionActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Content="Удалить" Height="42" Padding="10,0" Margin="0,0,6,0"
                                                        Style="{StaticResource DangerButtonStyle}" Click="DeleteSelectedButton_Click"/>
                                                <Button Content="Отмена" Height="42" Padding="10,0"
                                                        Style="{StaticResource LightButtonStyle}" Click="CancelSelectionButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА АДМИНИСТРАТОРА -->
                <TabItem x:Name="AdminTabItem" Header="Пользователи" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовок и кнопки действий над таблицей -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="Пользователи системы" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrushBlue}"/>
                                <TextBlock x:Name="AdminStatusTextBlock" Text="Загрузка..." FontSize="12"
                                           Foreground="#64748B" Margin="12,2,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AddUserButton" Content="Добавить" Width="105" Height="36" Margin="0,0,8,0"
                                        ToolTip="Добавить пользователя"
                                        Background="{StaticResource AccentBrush}"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="AddUserButton_Click"/>

                                <Button x:Name="EditUserButton" Content="Редактировать" Width="130" Height="36" Margin="0,0,8,0"
                                        ToolTip="Редактировать выбранного пользователя"
                                        Background="{StaticResource AccentBrush}"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="EditUserButton_Click"/>

                                <Button x:Name="DeleteUserButton" Content="Удалить" Width="95" Height="36"
                                        ToolTip="Удалить выбранного пользователя"
                                        Style="{StaticResource DangerButtonStyle}" Click="DeleteUserButton_Click"/>
                            </WrapPanel>
                        </Grid>

                        <!-- Таблица пользователей -->
                        <DataGrid x:Name="UsersDataGrid" Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanUserResizeColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" MinWidth="45"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="1.1*" MinWidth="100"/>
                                <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="1*" MinWidth="100"/>
                                <DataGridTextColumn Header="Роль" Binding="{Binding RoleDisplay}" Width="115" MinWidth="105"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="Заблок." Binding="{Binding IsBlockedDisplay}" Width="70" MinWidth="65"/>
                                <DataGridTextColumn Header="Причина блокировки" Binding="{Binding BlockReason}" Width="1.3*" MinWidth="120"/>
                                <DataGridTemplateColumn Header="Действие" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding BlockButtonText}"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource AdminGridButtonStyle}"
                                                    HorizontalAlignment="Center"
                                                    Click="BlockUserButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="AdminHintTextBlock" Grid.Row="2" Margin="0,8,0,0"
                                   Text="Выберите пользователя в таблице, чтобы редактировать или удалить его."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>

                <!-- ВКЛАДКА ЖУРНАЛА СОБЫТИЙ -->
                <TabItem x:Name="LogsTabItem" Header="Журнал событий" Visibility="Collapsed">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="260" />
                            <ColumnDefinition Width="4*" MinWidth="620" />
                        </Grid.ColumnDefinitions>

                        <!-- ДВЕ ОДИНАКОВЫЕ ТАБЛИЦЫ: КЛИЕНТ И СЕРВЕР -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10"
                                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Клиентские логи -->
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Журнал событий клиента" FontSize="13" FontWeight="Bold"
                                               Margin="0,0,0,6" Foreground="{StaticResource TextBrushBlue}"/>

                                    <DataGrid x:Name="ClientLogFilesDataGrid" Grid.Row="1"
                                              Style="{StaticResource AdminDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" MinWidth="80"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM HH:mm}"
                                                                Width="88" MinWidth="80"/>
                                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="58" MinWidth="52"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <!-- Серверные логи -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Журнал событий сервера" FontSize="13" FontWeight="Bold"
                                               Margin="0,0,0,6" Foreground="{StaticResource TextBrushBlue}"/>

                                    <DataGrid x:Name="ServerLogFilesDataGrid" Grid.Row="1"
                                              Style="{StaticResource AdminDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" MinWidth="80"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM HH:mm}"
                                                                Width="88" MinWidth="80"/>
                                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="58" MinWidth="52"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ТАБЛИЦА СОБЫТИЙ + ПРАВАЯ ПАНЕЛЬ -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <!-- События выбранного файла -->
                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10"
                                    BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                                <DataGrid x:Name="LogEntriesDataGrid"
                                          Style="{StaticResource AdminDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource AdminDataGridColumnHeaderStyle}"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата и время события" Binding="{Binding TimestampText}"
                                                            Width="170" MinWidth="160"/>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding Level}" Width="70" MinWidth="65"/>
                                        <DataGridTextColumn Header="Содержимое события" Binding="{Binding Message}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                    <Setter Property="Padding" Value="4,2"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Правая панель: информация, фильтры, легенда -->
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Информация о журнале -->
                                <Border Grid.Row="0" Background="#F8FBFF" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Общая информация о журнале" FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,8" Foreground="{StaticResource TextBrushBlue}"/>

                                        <TextBlock x:Name="LogNameTextBlock" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrushBlue}"/>

                                        <TextBlock x:Name="LogCountTextBlock" FontSize="13"
                                                   Margin="0,0,0,6" Foreground="{StaticResource TextBrushBlue}"/>

                                        <ItemsControl x:Name="LogTypesItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Ellipse Width="9" Height="10" Fill="{Binding Color}"
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatDisplay}" FontSize="12"
                                                                   Foreground="{StaticResource TextBrushBlue}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Фильтры -->
                                <Border Grid.Row="1" Background="#F8FBFF" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Фильтры" FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,10" Foreground="{StaticResource TextBrushBlue}"/>

                                        <TextBlock Text="Время с" FontSize="12" Margin="0,0,0,3"
                                                   Foreground="#64748B"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:NumericUpDown x:Name="FilterHourFromNumeric"
                                                                    Grid.Column="0" Height="28" Minimum="0" Maximum="23"
                                                                    Value="0"/>
                                            <TextBlock Grid.Column="1" Text=":" FontSize="15" FontWeight="Bold"
                                                       Margin="6,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrushBlue}"/>
                                            <controls:NumericUpDown x:Name="FilterMinuteFromNumeric"
                                                                    Grid.Column="2" Height="28" Minimum="0" Maximum="59"
                                                                    Value="0"/>
                                        </Grid>

                                        <TextBlock Text="Время по" FontSize="12" Margin="0,8,0,3"
                                                   Foreground="#64748B"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:NumericUpDown x:Name="FilterHourToNumeric"
                                                                    Grid.Column="0" Height="28" Minimum="0" Maximum="23"
                                                                    Value="23"/>
                                            <TextBlock Grid.Column="1" Text=":" FontSize="15" FontWeight="Bold"
                                                       Margin="6,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrushBlue}"/>
                                            <controls:NumericUpDown x:Name="FilterMinuteToNumeric"
                                                                    Grid.Column="2" Height="28" Minimum="0" Maximum="59"
                                                                    Value="59"/>
                                        </Grid>

                                        <TextBlock Text="Тип события" FontSize="12" Margin="0,8,0,3"
                                                   Foreground="#64748B"/>
                                        <ComboBox x:Name="FilterLevelComboBox" Height="28" FontSize="12"
                                                  Style="{StaticResource AdminComboBoxStyle}"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ApplyFilterButton" Grid.Column="0" Content="Применить"
                                                    Height="30" FontSize="12" Padding="0" Margin="0,0,3,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="ApplyFilterButton_Click"/>
                                            <Button x:Name="ResetFilterButton" Grid.Column="1" Content="Сбросить"
                                                    Height="30" FontSize="12" Padding="0" Margin="3,0,0,0"
                                                    Style="{StaticResource LightButtonStyle}"
                                                    Click="ResetFilterButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Легенда событий -->
                                <Border Grid.Row="2" Background="#F8FBFF" CornerRadius="8" Padding="12"
                                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Легенда событий" FontSize="14" FontWeight="Bold"
                                                   Margin="0,0,0,10" Foreground="{StaticResource TextBrushBlue}"/>

                                        <ItemsControl x:Name="LogLegendItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                        <Ellipse Width="9" Height="10" Fill="{Binding Color}"
                                                                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LegendDisplay}" FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrushBlue}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>
