<Window x:Class="RGRTU.Messenger.Client.Views.ChatAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вложения" Height="520" Width="700"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16"
                BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextBrushBlue}" Margin="0,0,0,10"/>

                <Border Grid.Row="1" Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrushBlue}" BorderThickness="1">
                    <ListBox x:Name="AttachmentsListBox" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FBFF" BorderBrush="{StaticResource BorderBrushBlue}"
                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrushBlue}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding InfoText}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Сохранить" Padding="12,6" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Style="{StaticResource LightButtonStyle}"
                                                Click="SaveAttachment_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>