{
  "Network": {
    "ServerIp": "127.0.0.1",
    "ServerPort": 9999,
    "ConnectionTimeoutMs": 5000
  },
  "Logging": {
    "DirectoryPath": "logs/",
    "FileNameTemplate": "client_log_.txt",
    "ConsoleOutputTemplate": "[{Timestamp:HH:mm:ss}] [{Level:u3}] [CLIENT] {Message:lj}{NewLine}{Exception}",
    "FileOutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [CLIENT] {Message:lj}{NewLine}{Exception}"
  },
  "BusinessRules": {
    "MinLoginLength": 3
  }
}