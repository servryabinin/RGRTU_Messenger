<UserControl x:Class="RGRTU.Messenger.Client.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="28">
    <Border Background="White"
            BorderBrush="{StaticResource BorderBrushBlue}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Grid.Column="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource TextBrushBlue}"
                     CaretBrush="{StaticResource AccentBrush}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Padding="4,0"
                     PreviewTextInput="ValueTextBox_PreviewTextInput"
                     LostFocus="ValueTextBox_LostFocus"
                     KeyUp="ValueTextBox_KeyUp"/>

            <Grid Grid.Column="1" Background="{StaticResource AccentLightBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <RepeatButton x:Name="IncreaseButton"
                              Grid.Row="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Delay="250"
                              Interval="60"
                              Click="IncreaseButton_Click">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Path Data="M 0 4 L 5 0 L 10 4"
                                      Stroke="{StaticResource TextBrushBlue}"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BorderBrushBlue}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <RepeatButton x:Name="DecreaseButton"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              Delay="250"
                              Interval="60"
                              Click="DecreaseButton_Click">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <Path Data="M 0 0 L 5 4 L 10 0"
                                      Stroke="{StaticResource TextBrushBlue}"
                                      StrokeThickness="1.5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource BorderBrushBlue}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
